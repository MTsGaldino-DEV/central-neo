# Copie para .env e preencha. Só variáveis VITE_ vão para o navegador.

# ─── 1. CENTRAL-NEO (principal) ─────────────────────────────────────────────
VITE_NEO_SUPABASE_URL=https://<ref-da-central-neo>.supabase.co
VITE_NEO_SUPABASE_ANON_KEY=<anon key da central-neo>
VITE_NEO_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... da central-neo>

# Somente servidor/scripts. NUNCA com prefixo VITE_.
NEO_SUPABASE_SERVICE_ROLE_KEY=<service_role da central-neo>
NEO_DB_PASSWORD=<senha do banco da central-neo>
NEO_DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ─── 2. TRACEONE (emprestado: medidores) ───────────────────────────────────
VITE_TRACEONE_SUPABASE_URL=https://<ref-do-traceone>.supabase.co
VITE_TRACEONE_SUPABASE_ANON_KEY=<anon key do TraceOne>

# URL do TraceOne web (telas que só existem lá: colaboradores, usuários)
VITE_TRACEONE_URL=
